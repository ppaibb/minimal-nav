{
  "name": "minimal-nav-cloudflare",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Nav - Cloudflare Pages + Workers + D1 Serverless Edition",
  "type": "module",
  "scripts": {
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "preview": "wrangler pages dev frontend/dist --d1 DB=minimal-nav-db",
    "d1:init:local": "wrangler d1 execute minimal-nav-db --local --file=./d1/schema.sql",
    "d1:init:remote": "wrangler d1 execute minimal-nav-db --remote --file=./d1/schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
